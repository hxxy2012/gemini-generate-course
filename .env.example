# 应用配置
APP_DEBUG = true

# 数据库配置
[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = course_genius
USERNAME = root
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = cg_

# Redis配置（可选）
[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD =

# Gemini API配置
[GEMINI]
API_KEY = your_gemini_api_key_here
MODEL = gemini-pro
